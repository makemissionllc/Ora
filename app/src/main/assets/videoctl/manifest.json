{
  "manifest_version": 2,
  "name": "Video control",
  "version": "1.1",
  "description": "Connects a full-screen video to Ora's seek bar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-control@ora.makemission.com"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
